(event EventBeginPlay
  (Cable|SetAttachEndtoComponent :self (Variables|Default|GetHose) :Component (Variables|Default|GetDrogue))
  (Variables|Default|SetFuel 1200.0)
  (Variables|Default|SetState 0)
  (Variables|Default|SetHoseLen 30.0)
  (Variables|Default|SetDrogueOff (Math|Vector|MakeVector :X 0.0 :Y 0.0 :Z 0.0))
  (Variables|Default|SetDrogueVel (Math|Vector|MakeVector :X 0.0 :Y 0.0 :Z 0.0))
  (Variables|Default|SetMsg "Hose stowed - it trails automatically (E = trail again)"))

(event EventTick (DeltaSeconds)
  (bind t (Utilities|Time|GetGameTimeinSeconds))
  (bind pod (Transformation|GetActorLocation))
  (bind mp (Utilities|Casting|CastToBP_MiragePawn :Object (Game|GetPlayerPawn :PlayerIndex 0))
    (:then
      (bind probe (Transformation|GetWorldLocation :self (Class|BPMiragePawn|GetProbeTip :self mp)))
      (bind vel (Class|BPMiragePawn|GetVelocity :self mp))
      (bind ext (Class|BPMiragePawn|GetExtendCount :self mp))
      (bind st (Variables|Default|GetState))
      (if (== st 0)
        (Variables|Default|SetHoseLen (Math|Interpolation|FInterpTo :Current (Variables|Default|GetHoseLen) :Target 30.0 :DeltaTime DeltaSeconds :InterpSpeed 2.0))
        (if (or (!= ext (Variables|Default|GetLastExtend)) (and (not (Variables|Default|GetAutoDone)) (> t 3.0)))
          (Variables|Default|SetLastExtend ext)
          (Variables|Default|SetAutoDone true)
          (Variables|Default|SetState 1)
          (Variables|Default|SetMsg "Hose trailing...")))
      (if (== st 1)
        (bind hl (+ (Variables|Default|GetHoseLen) (* 200.0 DeltaSeconds)))
        (Variables|Default|SetHoseLen hl)
        (if (>= hl 2400.0)
          (Variables|Default|SetHoseLen 2400.0)
          (Variables|Default|SetState 2)
          (Variables|Default|SetMsg "READY (amber) - fly the probe into the basket, closure 0.5-2.5 m/s")))
      (if (== st 4)
        (bind hl2 (- (Variables|Default|GetHoseLen) (* 200.0 DeltaSeconds)))
        (Variables|Default|SetHoseLen hl2)
        (if (<= hl2 30.0)
          (Variables|Default|SetState 0)
          (Variables|Default|SetMsg "Hose stowed. E = trail again, R = restart")))
      (bind hlen (Variables|Default|GetHoseLen))
      (bind k (/ hlen 2400.0))
      (bind wob (Math|Vector|MakeVector :X (* k (+ (* 12.0 (Math|Trig|Sin(Radians) (* t 0.8))) (* 4.0 (Math|Trig|Sin(Radians) (* t 2.1))))) :Y 0.0 :Z (* k (+ (* 8.0 (Math|Trig|Sin(Radians) (* t 1.1))) (* 3.0 (Math|Trig|Sin(Radians) (* t 2.7)))))))
      (bind free (+ (+ pod (* (Math|Vector|MakeVector :X 0.0 :Y -0.9877 :Z -0.1564) hlen)) wob))
      (bind drg (Variables|Default|GetDrogue))
      (if (== (Variables|Default|GetState) 3)
        (bind d (Math|Vector|Distance(Vector) :V1 pod :V2 probe))
        (Variables|Default|SetHoseLen d)
        (Transformation|SetWorldLocationAndRotation :self drg :NewLocation probe :NewRotation (Math|Rotator|MakeRotfromX :X (- pod probe)) :bSweep false :bTeleport true)
        (Variables|Default|SetDrogueOff (- probe free))
        (Variables|Default|SetDrogueVel vel)
        (bind push (- 2400.0 d))
        (bind lat (Math|Vector|Distance(Vector) :V1 probe :V2 (+ pod (* (Math|Vector|MakeVector :X 0.0 :Y -0.9877 :Z -0.1564) d))))
        (bind flowing (and (and (> push 150.0) (< push 900.0)) (< (Variables|Default|GetFuel) 3160.0)))
        (Variables|Default|SetFlowing flowing)
        (if flowing
          (Variables|Default|SetFuel (Math|Float|Min(Float) :A 3160.0 :B (+ (Variables|Default|GetFuel) (* 30.0 DeltaSeconds))))
          (Variables|Default|SetMsg "CONNECTED - GREEN: fuel flowing, hold position")
          (else
            (if (>= (Variables|Default|GetFuel) 3160.0)
              (Variables|Default|SetMsg "TANKS FULL - ease back to disconnect")
              (else
                (Variables|Default|SetMsg "CONNECTED - AMBER: push in 1.5-9 m for fuel flow")))))
        (if (< push -150.0)
          (Variables|Default|SetFlowing false)
          (if (>= (Variables|Default|GetFuel) 3160.0)
            (Variables|Default|SetState 4)
            (Variables|Default|SetMsg "Disconnected - refuel complete, hose rewinding")
            (else
              (Variables|Default|SetState 2)
              (Variables|Default|SetMsg "Disconnected (backed out) - try again"))))
        (if (> push 1000.0)
          (Variables|Default|SetFlowing false)
          (Variables|Default|SetState 2)
          (Variables|Default|SetMsg "Too far forward - hose slack, disconnected!"))
        (if (> lat (* 0.2 d))
          (Variables|Default|SetFlowing false)
          (Variables|Default|SetState 2)
          (Variables|Default|SetMsg "Off envelope - probe broke out of the drogue!"))
        (else
          (bind dt (Math|Float|Min(Float) :A DeltaSeconds :B 0.05))
          (bind off0 (Variables|Default|GetDrogueOff))
          (bind dv0 (Variables|Default|GetDrogueVel))
          (bind dvs (+ dv0 (* (- (* off0 -3.0) (* dv0 2.0)) dt)))
          (bind offs (+ off0 (* dvs dt)))
          (bind ax (Math|Vector|Normalize :A (- pod free)))
          (bind mt (Transformation|GetActorTransform :self mp))
          (bind cc1 (Math|Transform|TransformLocation :T mt :Location (Math|Vector|MakeVector :X 2.4 :Y 673.1 :Z -121.0)))
          (bind cc2 (Math|Transform|TransformLocation :T mt :Location (Math|Vector|MakeVector :X 2.4 :Y 603.1 :Z -111.0)))
          (bind cc3 (Math|Transform|TransformLocation :T mt :Location (Math|Vector|MakeVector :X 2.4 :Y 513.1 :Z -104.0)))
          (bind cc4 (Math|Transform|TransformLocation :T mt :Location (Math|Vector|MakeVector :X 2.4 :Y 423.1 :Z -96.0)))
          (bind cc5 (Math|Transform|TransformLocation :T mt :Location (Math|Vector|MakeVector :X 2.4 :Y 373.1 :Z -31.0)))
          (bind cc6 (Math|Transform|TransformLocation :T mt :Location (Math|Vector|MakeVector :X 2.4 :Y 283.1 :Z -6.0)))
          (bind cc7 (Math|Transform|TransformLocation :T mt :Location (Math|Vector|MakeVector :X 2.4 :Y 183.1 :Z -1.0)))
          (bind cc8 (Math|Transform|TransformLocation :T mt :Location (Math|Vector|MakeVector :X 2.4 :Y 313.1 :Z -96.0)))
          (bind bp1 (+ (+ free offs) (* ax 0.0)))
          (bind dd1 (- bp1 cc1))
          (bind ds1 (Math|Float|Max(Float) :A (Math|Vector|VectorLength :A dd1) :B 0.01))
          (bind pn1 (Math|Float|Max(Float) :A (- 27.0 ds1) :B 0.0))
          (bind nn1 (/ dd1 ds1))
          (bind vn1 (Math|Float|SelectFloat :A (Math|Float|Min(Float) :A (Math|Vector|DotProduct :A (- dvs vel) :B nn1) :B 0.0) :B 0.0 :bPickA (> pn1 0.0)))
          (bind off1 (+ offs (* nn1 pn1)))
          (bind dv1 (- dvs (* nn1 (* vn1 1.3))))
          (bind bp2 (+ (+ free off1) (* ax 0.0)))
          (bind dd2 (- bp2 cc2))
          (bind ds2 (Math|Float|Max(Float) :A (Math|Vector|VectorLength :A dd2) :B 0.01))
          (bind pn2 (Math|Float|Max(Float) :A (- 37.0 ds2) :B 0.0))
          (bind nn2 (/ dd2 ds2))
          (bind vn2 (Math|Float|SelectFloat :A (Math|Float|Min(Float) :A (Math|Vector|DotProduct :A (- dv1 vel) :B nn2) :B 0.0) :B 0.0 :bPickA (> pn2 0.0)))
          (bind off2 (+ off1 (* nn2 pn2)))
          (bind dv2 (- dv1 (* nn2 (* vn2 1.3))))
          (bind bp3 (+ (+ free off2) (* ax 0.0)))
          (bind dd3 (- bp3 cc3))
          (bind ds3 (Math|Float|Max(Float) :A (Math|Vector|VectorLength :A dd3) :B 0.01))
          (bind pn3 (Math|Float|Max(Float) :A (- 48.0 ds3) :B 0.0))
          (bind nn3 (/ dd3 ds3))
          (bind vn3 (Math|Float|SelectFloat :A (Math|Float|Min(Float) :A (Math|Vector|DotProduct :A (- dv2 vel) :B nn3) :B 0.0) :B 0.0 :bPickA (> pn3 0.0)))
          (bind off3 (+ off2 (* nn3 pn3)))
          (bind dv3 (- dv2 (* nn3 (* vn3 1.3))))
          (bind bp4 (+ (+ free off3) (* ax 0.0)))
          (bind dd4 (- bp4 cc4))
          (bind ds4 (Math|Float|Max(Float) :A (Math|Vector|VectorLength :A dd4) :B 0.01))
          (bind pn4 (Math|Float|Max(Float) :A (- 60.0 ds4) :B 0.0))
          (bind nn4 (/ dd4 ds4))
          (bind vn4 (Math|Float|SelectFloat :A (Math|Float|Min(Float) :A (Math|Vector|DotProduct :A (- dv3 vel) :B nn4) :B 0.0) :B 0.0 :bPickA (> pn4 0.0)))
          (bind off4 (+ off3 (* nn4 pn4)))
          (bind dv4 (- dv3 (* nn4 (* vn4 1.3))))
          (bind bp5 (+ (+ free off4) (* ax 0.0)))
          (bind dd5 (- bp5 cc5))
          (bind ds5 (Math|Float|Max(Float) :A (Math|Vector|VectorLength :A dd5) :B 0.01))
          (bind pn5 (Math|Float|Max(Float) :A (- 55.0 ds5) :B 0.0))
          (bind nn5 (/ dd5 ds5))
          (bind vn5 (Math|Float|SelectFloat :A (Math|Float|Min(Float) :A (Math|Vector|DotProduct :A (- dv4 vel) :B nn5) :B 0.0) :B 0.0 :bPickA (> pn5 0.0)))
          (bind off5 (+ off4 (* nn5 pn5)))
          (bind dv5 (- dv4 (* nn5 (* vn5 1.3))))
          (bind bp6 (+ (+ free off5) (* ax 0.0)))
          (bind dd6 (- bp6 cc6))
          (bind ds6 (Math|Float|Max(Float) :A (Math|Vector|VectorLength :A dd6) :B 0.01))
          (bind pn6 (Math|Float|Max(Float) :A (- 60.0 ds6) :B 0.0))
          (bind nn6 (/ dd6 ds6))
          (bind vn6 (Math|Float|SelectFloat :A (Math|Float|Min(Float) :A (Math|Vector|DotProduct :A (- dv5 vel) :B nn6) :B 0.0) :B 0.0 :bPickA (> pn6 0.0)))
          (bind off6 (+ off5 (* nn6 pn6)))
          (bind dv6 (- dv5 (* nn6 (* vn6 1.3))))
          (bind bp7 (+ (+ free off6) (* ax 0.0)))
          (bind dd7 (- bp7 cc7))
          (bind ds7 (Math|Float|Max(Float) :A (Math|Vector|VectorLength :A dd7) :B 0.01))
          (bind pn7 (Math|Float|Max(Float) :A (- 60.0 ds7) :B 0.0))
          (bind nn7 (/ dd7 ds7))
          (bind vn7 (Math|Float|SelectFloat :A (Math|Float|Min(Float) :A (Math|Vector|DotProduct :A (- dv6 vel) :B nn7) :B 0.0) :B 0.0 :bPickA (> pn7 0.0)))
          (bind off7 (+ off6 (* nn7 pn7)))
          (bind dv7 (- dv6 (* nn7 (* vn7 1.3))))
          (bind bp8 (+ (+ free off7) (* ax 0.0)))
          (bind dd8 (- bp8 cc8))
          (bind ds8 (Math|Float|Max(Float) :A (Math|Vector|VectorLength :A dd8) :B 0.01))
          (bind pn8 (Math|Float|Max(Float) :A (- 65.0 ds8) :B 0.0))
          (bind nn8 (/ dd8 ds8))
          (bind vn8 (Math|Float|SelectFloat :A (Math|Float|Min(Float) :A (Math|Vector|DotProduct :A (- dv7 vel) :B nn8) :B 0.0) :B 0.0 :bPickA (> pn8 0.0)))
          (bind off8 (+ off7 (* nn8 pn8)))
          (bind dv8 (- dv7 (* nn8 (* vn8 1.3))))
          (bind bp9 (+ (+ free off8) (* ax -55.0)))
          (bind dd9 (- bp9 cc1))
          (bind ds9 (Math|Float|Max(Float) :A (Math|Vector|VectorLength :A dd9) :B 0.01))
          (bind pn9 (Math|Float|Max(Float) :A (- 44.0 ds9) :B 0.0))
          (bind nn9 (/ dd9 ds9))
          (bind vn9 (Math|Float|SelectFloat :A (Math|Float|Min(Float) :A (Math|Vector|DotProduct :A (- dv8 vel) :B nn9) :B 0.0) :B 0.0 :bPickA (> pn9 0.0)))
          (bind off9 (+ off8 (* nn9 pn9)))
          (bind dv9 (- dv8 (* nn9 (* vn9 1.3))))
          (bind bp10 (+ (+ free off9) (* ax -55.0)))
          (bind dd10 (- bp10 cc2))
          (bind ds10 (Math|Float|Max(Float) :A (Math|Vector|VectorLength :A dd10) :B 0.01))
          (bind pn10 (Math|Float|Max(Float) :A (- 54.0 ds10) :B 0.0))
          (bind nn10 (/ dd10 ds10))
          (bind vn10 (Math|Float|SelectFloat :A (Math|Float|Min(Float) :A (Math|Vector|DotProduct :A (- dv9 vel) :B nn10) :B 0.0) :B 0.0 :bPickA (> pn10 0.0)))
          (bind off10 (+ off9 (* nn10 pn10)))
          (bind dv10 (- dv9 (* nn10 (* vn10 1.3))))
          (bind bp11 (+ (+ free off10) (* ax -55.0)))
          (bind dd11 (- bp11 cc3))
          (bind ds11 (Math|Float|Max(Float) :A (Math|Vector|VectorLength :A dd11) :B 0.01))
          (bind pn11 (Math|Float|Max(Float) :A (- 65.0 ds11) :B 0.0))
          (bind nn11 (/ dd11 ds11))
          (bind vn11 (Math|Float|SelectFloat :A (Math|Float|Min(Float) :A (Math|Vector|DotProduct :A (- dv10 vel) :B nn11) :B 0.0) :B 0.0 :bPickA (> pn11 0.0)))
          (bind off11 (+ off10 (* nn11 pn11)))
          (bind dv11 (- dv10 (* nn11 (* vn11 1.3))))
          (bind bp12 (+ (+ free off11) (* ax -55.0)))
          (bind dd12 (- bp12 cc4))
          (bind ds12 (Math|Float|Max(Float) :A (Math|Vector|VectorLength :A dd12) :B 0.01))
          (bind pn12 (Math|Float|Max(Float) :A (- 77.0 ds12) :B 0.0))
          (bind nn12 (/ dd12 ds12))
          (bind vn12 (Math|Float|SelectFloat :A (Math|Float|Min(Float) :A (Math|Vector|DotProduct :A (- dv11 vel) :B nn12) :B 0.0) :B 0.0 :bPickA (> pn12 0.0)))
          (bind off12 (+ off11 (* nn12 pn12)))
          (bind dv12 (- dv11 (* nn12 (* vn12 1.3))))
          (bind bp13 (+ (+ free off12) (* ax -55.0)))
          (bind dd13 (- bp13 cc5))
          (bind ds13 (Math|Float|Max(Float) :A (Math|Vector|VectorLength :A dd13) :B 0.01))
          (bind pn13 (Math|Float|Max(Float) :A (- 72.0 ds13) :B 0.0))
          (bind nn13 (/ dd13 ds13))
          (bind vn13 (Math|Float|SelectFloat :A (Math|Float|Min(Float) :A (Math|Vector|DotProduct :A (- dv12 vel) :B nn13) :B 0.0) :B 0.0 :bPickA (> pn13 0.0)))
          (bind off13 (+ off12 (* nn13 pn13)))
          (bind dv13 (- dv12 (* nn13 (* vn13 1.3))))
          (bind bp14 (+ (+ free off13) (* ax -55.0)))
          (bind dd14 (- bp14 cc6))
          (bind ds14 (Math|Float|Max(Float) :A (Math|Vector|VectorLength :A dd14) :B 0.01))
          (bind pn14 (Math|Float|Max(Float) :A (- 77.0 ds14) :B 0.0))
          (bind nn14 (/ dd14 ds14))
          (bind vn14 (Math|Float|SelectFloat :A (Math|Float|Min(Float) :A (Math|Vector|DotProduct :A (- dv13 vel) :B nn14) :B 0.0) :B 0.0 :bPickA (> pn14 0.0)))
          (bind off14 (+ off13 (* nn14 pn14)))
          (bind dv14 (- dv13 (* nn14 (* vn14 1.3))))
          (bind bp15 (+ (+ free off14) (* ax -55.0)))
          (bind dd15 (- bp15 cc7))
          (bind ds15 (Math|Float|Max(Float) :A (Math|Vector|VectorLength :A dd15) :B 0.01))
          (bind pn15 (Math|Float|Max(Float) :A (- 77.0 ds15) :B 0.0))
          (bind nn15 (/ dd15 ds15))
          (bind vn15 (Math|Float|SelectFloat :A (Math|Float|Min(Float) :A (Math|Vector|DotProduct :A (- dv14 vel) :B nn15) :B 0.0) :B 0.0 :bPickA (> pn15 0.0)))
          (bind off15 (+ off14 (* nn15 pn15)))
          (bind dv15 (- dv14 (* nn15 (* vn15 1.3))))
          (bind bp16 (+ (+ free off15) (* ax -55.0)))
          (bind dd16 (- bp16 cc8))
          (bind ds16 (Math|Float|Max(Float) :A (Math|Vector|VectorLength :A dd16) :B 0.01))
          (bind pn16 (Math|Float|Max(Float) :A (- 82.0 ds16) :B 0.0))
          (bind nn16 (/ dd16 ds16))
          (bind vn16 (Math|Float|SelectFloat :A (Math|Float|Min(Float) :A (Math|Vector|DotProduct :A (- dv15 vel) :B nn16) :B 0.0) :B 0.0 :bPickA (> pn16 0.0)))
          (bind off16 (+ off15 (* nn16 pn16)))
          (bind dv16 (- dv15 (* nn16 (* vn16 1.3))))
          (bind pos (+ free off16))
          (bind rot (Math|Rotator|MakeRotfromX :X (- pod pos)))
          (bind loc (Math|Transform|InverseTransformLocation :T (Math|Transform|MakeTransform :Location pos :Rotation rot :Scale (Math|Vector|MakeVector :X 1.0 :Y 1.0 :Z 1.0)) :Location probe))
          (bind rad (Math|Float|Sqrt (+ (* (.y loc) (.y loc)) (* (.z loc) (.z loc)))))
          (bind inwin (and (> (.x loc) -95.0) (< (.x loc) 5.0)))
          (bind rgt (Math|Vector|GetRightVector :InRot rot))
          (bind upv (Math|Vector|GetUpVector :InRot rot))
          (bind fwd (Math|Vector|GetForwardVector :InRot rot))
          (bind away (* (+ (* rgt (.y loc)) (* upv (.z loc))) (/ -1.0 (Math|Float|Max(Float) :A rad :B 0.1))))
          (bind rim (and inwin (and (>= rad 20.0) (< rad 44.0))))
          (bind inopen (and inwin (< rad 20.0)))
          (bind rimpen (Math|Float|SelectFloat :A (- 44.0 rad) :B 0.0 :bPickA rim))
          (bind hubpush (Math|Float|SelectFloat :A (Math|Float|Max(Float) :A (+ (.x loc) 2.0) :B 0.0) :B 0.0 :bPickA inopen))
          (bind offr (+ (+ off16 (* away rimpen)) (* fwd hubpush)))
          (bind dvr (+ dv16 (* away (Math|Float|SelectFloat :A 120.0 :B 0.0 :bPickA rim))))
          (Variables|Default|SetDrogueOff offr)
          (Variables|Default|SetDrogueVel (Math|Vector|ClampVectorSize :A dvr :Min 0.0 :Max 800.0))
          (bind pos2 (+ free offr))
          (Transformation|SetWorldLocationAndRotation :self drg :NewLocation pos2 :NewRotation (Math|Rotator|MakeRotfromX :X (- pod pos2)) :bSweep false :bTeleport true)
          (if rim
            (Variables|Default|SetMsg "Hit the basket rim - back out and line up again"))
          (if (and (== (Variables|Default|GetState) 2) (and inopen (> (.x loc) -60.0)))
            (bind clos (.y vel))
            (if (> clos 250.0)
              (Variables|Default|SetDrogueVel (+ (Variables|Default|GetDrogueVel) (+ (* rgt (Math|Float|SelectFloat :A -200.0 :B 200.0 :bPickA (>= (.y loc) 0.0))) (* upv 90.0))))
              (Variables|Default|SetMsg "TOO FAST - the basket was knocked off (max closure 2.5 m/s)")
              (elif (< clos 40.0)
                (Variables|Default|SetMsg "Closure too slow - the probe did not latch (min 0.5 m/s)")
                (else
                  (Variables|Default|SetState 3)
                  (Variables|Default|SetMsg "CONTACT! Keep pushing in for the green light")))))))
      (Class|CableComponent|SetCableLength :self (Variables|Default|GetHose) :CableLength (Math|Float|Max(Float) :A 20.0 :B (Variables|Default|GetHoseLen)))
      (bind dprobe (Math|Vector|Distance(Vector) :V1 probe :V2 (Transformation|GetWorldLocation :self drg)))
      (bind line (Utilities|String|Append :A (Variables|Default|GetMsg) :B (Utilities|String|Append :A "    |  range " :B (Utilities|String|Append :A (Utilities|String|ToString(Integer) (Math|Float|Round (/ dprobe 100.0))) :B (Utilities|String|Append :A " m  |  closure " :B (Utilities|String|Append :A (Utilities|String|ToString(Integer) (Math|Float|Round (.y vel))) :B (Utilities|String|Append :A " cm/s  |  fuel " :B (Utilities|String|Append :A (Utilities|String|ToString(Integer) (Math|Float|Round (/ (Variables|Default|GetFuel) 31.6))) :B "%"))))))))
      (Development|PrintString :InString "W/S fwd-back   A/D strafe   Space/Ctrl up-down   Shift fast   Mouse look   C recenter   E trail hose   R restart" :bPrintToScreen true :bPrintToLog false :TextColor "(R=0.7,G=0.7,B=0.7,A=1.0)" :Duration 0.25 :Key "RefuelHelp")
      (if (Variables|Default|GetFlowing)
        (Development|PrintString :InString line :bPrintToScreen true :bPrintToLog false :TextColor "(R=0.1,G=1.0,B=0.2,A=1.0)" :Duration 0.25 :Key "RefuelHUD")
        (else
          (Development|PrintString :InString line :bPrintToScreen true :bPrintToLog false :TextColor "(R=1.0,G=0.65,B=0.0,A=1.0)" :Duration 0.25 :Key "RefuelHUD"))))
    (:CastFailed)))
