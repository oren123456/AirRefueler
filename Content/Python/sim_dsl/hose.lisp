(event EventBeginPlay
  ; start with the hose fully trailed (READY); E / joystick button 2 rewinds it
  (bind trail (+ (Transformation|GetActorLocation) (* (Math|Vector|MakeVector :X 0.0 :Y -0.9877 :Z -0.1564) 2400.0)))
  (Physics|SetSimulatePhysics :self (Variables|Default|GetParachute) :bSimulate false)
  (Transformation|SetWorldLocationAndRotation :self (Variables|Default|GetParachute) :NewLocation trail :NewRotation (Math|Rotator|MakeRotfromX :X (- (Transformation|GetActorLocation) trail)) :bSweep false :bTeleport true)
  (Cable|SetAttachEndtoComponent :self (Variables|Default|GetHose) :Component (Variables|Default|GetParachute))
  (Class|CableComponent|SetCableLength :self (Variables|Default|GetHose) :CableLength 2376.0)
  (Variables|Default|SetDP trail)
  (Variables|Default|SetDV (Math|Vector|MakeVector :X 0.0 :Y 0.0 :Z 0.0))
  (Variables|Default|SetFuel 1200.0)
  (Variables|Default|SetHoseLen 2400.0)
  (Variables|Default|SetReelLen 2400.0)
  (Variables|Default|SetWT -100.0)
  (Variables|Default|SetState 2)
  (Variables|Default|SetMsg "READY (amber) - fly the probe into the basket, closure 0.5-2.5 m/s  (E / button 2 = rewind)"))

(event EventTick (DeltaSeconds)
  (bind t (Utilities|Time|GetGameTimeinSeconds))
  (bind pod (Transformation|GetActorLocation))
  (bind mp (Utilities|Casting|CastToBP_MiragePawn :Object (Game|GetPlayerPawn :PlayerIndex 0))
    (:then
      (bind probe (Transformation|GetWorldLocation :self (Class|BPMiragePawn|GetProbeTip :self mp)))
      (bind vel (Class|BPMiragePawn|GetVelocity :self mp))
      (bind ext (Class|BPMiragePawn|GetExtendCount :self mp))
      (bind st (Variables|Default|GetState))
      ; hose whip envelope: 1.8 s decaying 2.5 Hz oscillation thrown into the drogue end (+ extra slack)
      (Variables|Default|SetWK (* (Math|Float|Max(Float) :A 0.0 :B (- 1.0 (/ (- t (Variables|Default|GetWT)) 1.8))) (Math|Float|Max(Float) :A 0.0 :B (- 1.0 (/ (- t (Variables|Default|GetWT)) 1.8)))))
      (Variables|Default|SetWA (* (* 900.0 (Variables|Default|GetWK)) (Math|Trig|Sin(Radians) (* (- t (Variables|Default|GetWT)) 15.7))))
      ; hose out / in: E or joystick button 2 toggles (no automatic trailing)
      (if (!= ext (Variables|Default|GetLastExtend))
        (Variables|Default|SetLastExtend ext)
        (if (or (== st 0) (== st 4))
          (Variables|Default|SetState 1)
          (Variables|Default|SetMsg "Hose trailing...  (E / button 2 = rewind)")
          (elif (or (== st 1) (== st 2))
            (Variables|Default|SetState 4)
            (Variables|Default|SetMsg "Hose rewinding...  (E / button 2 = trail)"))))
      ; manual lock: L / joystick button 4 locks when the probe tip is inside the basket (80 cm behind to 5 cm past the hub,
      ; 12 cm of the axis; CX/CR from the last frame), at any closure speed. Pressing it again unlocks.
      (bind lk (Class|BPMiragePawn|GetLockCount :self mp))
      (if (!= lk (Variables|Default|GetLastLock))
        (Variables|Default|SetLastLock lk)
        (if (== st 3)
          (Variables|Default|SetState 2)
          (Variables|Default|SetFlowing false)
          (Variables|Default|SetKO (+ t 1.5))
          (Variables|Default|SetMsg "UNLOCKED (L) - back out of the basket")
          (elif (== st 2)
            (if (and (and (> (Variables|Default|GetCX) -80.0) (< (Variables|Default|GetCX) 5.0)) (< (Variables|Default|GetCR) 12.0))
              (Variables|Default|SetState 3)
              (Class|BPMiragePawn|SetVelocity :self mp :Velocity (Math|Vector|MakeVector :X 0.0 :Y 0.0 :Z 0.0))
              (Class|BPMiragePawn|SetKThr :self mp :KThr 0.0)
              (Variables|Default|SetMsg "LOCKED (L) - push in 1.5-9 m for fuel flow, L again to unlock")
              (else
                (Variables|Default|SetMsg (Utilities|String|Append :A "Not in lock range (L): " :B (Utilities|String|Append :A (Utilities|String|ToString(Integer) (Math|Float|Round (Math|Float|Max(Float) :A 0.0 :B (- -49.5 (Variables|Default|GetCX))))) :B (Utilities|String|Append :A " cm short of the coupling (max 30), " :B (Utilities|String|Append :A (Utilities|String|ToString(Integer) (Math|Float|Round (Variables|Default|GetCR))) :B " cm off-axis (max 12)"))))))))))
      (if (== st 0)
        (Variables|Default|SetHoseLen (Math|Interpolation|FInterpTo :Current (Variables|Default|GetHoseLen) :Target -76.0 :DeltaTime DeltaSeconds :InterpSpeed 2.0)))
      (if (== st 1)
        (bind hl (+ (Variables|Default|GetHoseLen) (* 200.0 DeltaSeconds)))
        (Variables|Default|SetHoseLen hl)
        (if (>= hl 2400.0)
          (Variables|Default|SetHoseLen 2400.0)
          (Variables|Default|SetState 2)
          (Variables|Default|SetMsg "READY (amber) - fly the probe into the basket, closure 0.5-2.5 m/s  (E / button 2 = rewind)")))
      (if (== st 4)
        ; reel slows to 0.5 m/s for the last 1.5 m so the basket docks gently into the pod tunnel
        (bind hl2 (- (Variables|Default|GetHoseLen) (* (Math|Float|SelectFloat :A 200.0 :B 50.0 :bPickA (> (Variables|Default|GetHoseLen) 150.0)) DeltaSeconds)))
        (Variables|Default|SetHoseLen hl2)
        (if (<= hl2 -76.0)
          (Variables|Default|SetState 0)
          (Variables|Default|SetMsg "Hose stowed - E / joystick button 2 to trail again, R = restart")))
      (bind hlen (Variables|Default|GetHoseLen))
      (bind k (Math|Float|Max(Float) :A 0.0 :B (/ hlen 2400.0)))
      ; turbulence: gusty 3-frequency motion of the trail point (~ +/-0.6 m lateral/vertical at full trail), x TurbAmp
      (bind ta (* k (Variables|Realism|GetTurbAmp)))
      (bind wob (Math|Vector|MakeVector :X (* ta (+ (* 40.0 (Math|Trig|Sin(Radians) (+ (* t 0.55) 0.0))) (+ (* 22.0 (Math|Trig|Sin(Radians) (+ (* t 1.37) 1.3))) (* 10.0 (Math|Trig|Sin(Radians) (+ (* t 2.9) 0.4)))))) :Y (* ta (+ (* 18.0 (Math|Trig|Sin(Radians) (+ (* t 0.31) 1.0))) (* 8.0 (Math|Trig|Sin(Radians) (+ (* t 0.83) 2.2))))) :Z (* ta (+ (* 32.0 (Math|Trig|Sin(Radians) (+ (* t 0.47) 2.1))) (+ (* 18.0 (Math|Trig|Sin(Radians) (+ (* t 1.13) 0.7))) (* 8.0 (Math|Trig|Sin(Radians) (+ (* t 3.3) 2.5))))))))
      ; trail point; HoseLen < 0 = drawn into the pod tunnel along the pod axis (stowed at -76: basket rim at the mouth)
      (bind free (+ (+ (+ pod (* (Math|Vector|MakeVector :X 0.0 :Y -0.9877 :Z -0.1564) (Math|Float|Max(Float) :A 0.0 :B hlen))) (Math|Vector|MakeVector :X 0.0 :Y (Math|Float|Max(Float) :A 0.0 :B (- 0.0 hlen)) :Z 0.0)) wob))
      (bind drg (Variables|Default|GetParachute))
      ; the canopy folds radially (to 85 %) as it is drawn into the tunnel
      (Transformation|SetRelativeScale3D :self drg :NewScale3D (Math|Vector|MakeVector :X 1.0 :Y (- 1.0 (* 0.15 (Math|Float|Clamp(Float) :Value (/ (- -30.0 hlen) 46.0) :Min 0.0 :Max 1.0))) :Z (- 1.0 (* 0.15 (Math|Float|Clamp(Float) :Value (/ (- -30.0 hlen) 46.0) :Min 0.0 :Max 1.0)))))
      (if (== (Variables|Default|GetState) 3)
        (bind d (Math|Vector|Distance(Vector) :V1 pod :V2 probe))
        (Variables|Default|SetHoseLen d)
        ; latched: the probe sits 15 cm past the throat in the coupling (34.5 cm behind the hub); blend there, no snap
        (Variables|Default|SetDP (Math|Interpolation|VInterpTo :Current (Variables|Default|GetDP) :Target (+ probe (* (Math|Vector|GetForwardVector :InRot (Math|Rotator|MakeRotfromX :X (- pod probe))) 34.5)) :DeltaTime DeltaSeconds :InterpSpeed 12.0))
        (Variables|Default|SetDV vel)
        (Transformation|SetWorldLocationAndRotation :self drg :NewLocation (Variables|Default|GetDP) :NewRotation (Math|Rotator|MakeRotfromX :X (- pod (Variables|Default|GetDP))) :bSweep false :bTeleport true)
        (bind push (- 2400.0 d))
        (bind lat (Math|Vector|Distance(Vector) :V1 probe :V2 (+ pod (* (Math|Vector|MakeVector :X 0.0 :Y -0.9877 :Z -0.1564) d))))
        (bind flowing (and (and (> push 150.0) (< push 900.0)) (< (Variables|Default|GetFuel) 3160.0)))
        (Variables|Default|SetFlowing flowing)
        (if flowing
          (Variables|Default|SetFuel (Math|Float|Min(Float) :A 3160.0 :B (+ (Variables|Default|GetFuel) (* 30.0 DeltaSeconds))))
          (Variables|Default|SetMsg "CONNECTED - GREEN: fuel flowing, hold position")
          (else
            (if (>= (Variables|Default|GetFuel) 3160.0)
              (Variables|Default|SetMsg "TANKS FULL - ease back to disconnect")
              (else
                (Variables|Default|SetMsg "CONNECTED - AMBER: push in 1.5-9 m for fuel flow")))))
        (if (< push -150.0)
          (Variables|Default|SetFlowing false)
          (if (>= (Variables|Default|GetFuel) 3160.0)
            (Variables|Default|SetState 4)
            (Variables|Default|SetKO (+ t 1.5))
          (Variables|Default|SetMsg "Disconnected - refuel complete, hose rewinding")
            (else
              (Variables|Default|SetState 2)
              (Variables|Default|SetKO (+ t 1.5))
          (Variables|Default|SetMsg "Disconnected (backed out) - try again"))))
        (if (> push 1000.0)
          (Variables|Default|SetFlowing false)
          (Variables|Default|SetState 2)
          (Variables|Default|SetKO (+ t 1.5))
          (Variables|Default|SetWT t)
          (Variables|Default|SetWD (Math|Vector|MakeVector :X (Math|Float|SelectFloat :A 1.0 :B -1.0 :bPickA (> (Math|Trig|Sin(Radians) (* t 7.0)) 0.0)) :Y 0.0 :Z 0.5))
          (Variables|Default|SetMsg "Too far forward - hose slack, disconnected!"))
        (if (> lat (* 0.2 d))
          (Variables|Default|SetFlowing false)
          (Variables|Default|SetState 2)
          (Variables|Default|SetKO (+ t 1.5))
          (Variables|Default|SetMsg "Off envelope - probe broke out of the drogue!"))
        (else
          ; ---- free drogue: own integrator; contact = Unreal sweeps of the parachute's 24 convex hulls against the
          ; refuelling probe's per-polygon collision (the only two colliding objects in the scene).
          (bind dt (Math|Float|Min(Float) :A DeltaSeconds :B 0.05))
          (bind kf (Math|Float|Min(Float) :A 1.0 :B (* 4.0 dt)))
          (if (> (Math|Vector|Distance(Vector) :V1 probe :V2 (Variables|Default|GetLP)) 200.0)
            (Variables|Default|SetLP probe))
          ; bow wave: the Mirage nose (7.5 m ahead of the pawn origin) pushes the basket outward/up within 4 m,
          ; growing quadratically as it closes in (x BowStrength, cm/s^2 at the nose)
          (bind nose (+ (Transformation|GetActorLocation :self mp) (Math|Vector|MakeVector :X 0.0 :Y 750.0 :Z 30.0)))
          (bind rel (- (Variables|Default|GetDP) nose))
          (bind lat (Math|Vector|MakeVector :X (.x rel) :Y 0.0 :Z (+ (.z rel) 40.0)))
          (Variables|Default|SetBF (Math|Float|Clamp(Float) :Value (- 1.0 (/ (Math|Vector|Distance(Vector) :V1 (Variables|Default|GetDP) :V2 nose) 400.0)) :Min 0.0 :Max 1.0))
          (Variables|Default|SetBL (Math|Float|Max(Float) :A 1.0 :B (Math|Float|Sqrt (+ (* (.x lat) (.x lat)) (* (.z lat) (.z lat))))))
          (Variables|Default|SetBI (/ (* (Variables|Realism|GetBowStrength) (* (Variables|Default|GetBF) (Variables|Default|GetBF))) (Variables|Default|GetBL)))
          ; spring-damper toward the trail point + bow wave
          ; stiffer, near-critically damped spring close to / inside the pod (no wobble in the tunnel)
          (bind cn (Math|Float|Clamp(Float) :Value (- 1.0 (/ hlen 150.0)) :Min 0.0 :Max 1.0))
          (bind V1 (+ (Variables|Default|GetDV) (* (+ (- (* (- free (Variables|Default|GetDP)) (+ 3.0 (* 47.0 cn))) (* (Variables|Default|GetDV) (+ 2.0 (* 12.0 cn)))) (+ (* lat (Variables|Default|GetBI)) (* (Variables|Default|GetWD) (Variables|Default|GetWA)))) dt)))
          (Variables|Default|SetDV V1)
          (Variables|Default|SetTG (+ (Variables|Default|GetDP) (* (Variables|Default|GetDV) dt)))
          ; drogue axis: toward the pod; blends to the pod axis (+Y) as it reaches / enters the tunnel
          (bind rot (Math|Rotator|MakeRotfromX :X (+ (- pod (Variables|Default|GetDP)) (Math|Vector|MakeVector :X 0.0 :Y (* 300.0 (Math|Float|Clamp(Float) :Value (- 1.0 (/ hlen 100.0)) :Min 0.0 :Max 2.0)) :Z 0.0))))
          (bind fwd (Math|Vector|GetForwardVector :InRot rot))
          (bind vrel (- (Variables|Default|GetDV) vel))
          ; closure along the basket axis, before any contact changes the drogue velocity
          (Variables|Default|SetCL (Math|Vector|DotProduct :A (- vel (Variables|Default|GetDV)) :B fwd))
          ; 1) carry the drogue by the probe's motion this frame (same relative pose as last frame = no overlap) ...
          (Transformation|SetWorldLocationAndRotation :self drg :NewLocation (+ (Variables|Default|GetDP) (- probe (Variables|Default|GetLP))) :NewRotation rot :bSweep false :bTeleport true)
          ; 2) ... then sweep the hulls to where the drogue wants to be; the probe stops it where they really touch
          (bind hit1 (Transformation|SetWorldLocation :self drg :NewLocation (Variables|Default|GetTG) :bSweep true :bTeleport false))
          (bind (b1 o1 t1 d1 l1 i1 n1 in1) (Collision|BreakHitResult :Hit hit1))
          (if b1
            ; started inside (e.g. right after a disconnect): ease out along the depenetration normal
            (if o1
              (Transformation|SetWorldLocation :self drg :NewLocation (+ (Transformation|GetWorldLocation :self drg) (* n1 2.0)) :bSweep false :bTeleport true))
            ; inelastic contact + friction, relative to the probe; drogue compliance lateral 1 / axial 0.15
            (Variables|Default|SetD1 (- 1.0 (* 0.85 (* (Math|Vector|DotProduct :A n1 :B fwd) (Math|Vector|DotProduct :A n1 :B fwd)))))
            (Variables|Default|SetVN (/ (Math|Float|Min(Float) :A 0.0 :B (Math|Vector|DotProduct :A vrel :B n1)) (Variables|Default|GetD1)))
            (Variables|Default|SetDV (- (- (Variables|Default|GetDV) (* (- n1 (* (* fwd (Math|Vector|DotProduct :A n1 :B fwd)) 0.85)) (Variables|Default|GetVN))) (* (- (- vrel (* n1 (Math|Vector|DotProduct :A vrel :B n1))) (* (* fwd (Math|Vector|DotProduct :A (- vrel (* n1 (Math|Vector|DotProduct :A vrel :B n1))) :B fwd)) 0.85)) kf)))
            ; 3) slide the rest of the move along the contact plane (the canopy funnels the probe)
            (bind rem (- (Variables|Default|GetTG) (Transformation|GetWorldLocation :self drg)))
            (Transformation|SetWorldLocation :self drg :NewLocation (+ (Transformation|GetWorldLocation :self drg) (- rem (* n1 (Math|Vector|DotProduct :A rem :B n1)))) :bSweep true :bTeleport false))
          (Variables|Default|SetDP (Transformation|GetWorldLocation :self drg))
          (Transformation|SetWorldRotation :self drg :NewRotation (Math|Rotator|MakeRotfromX :X (+ (- pod (Variables|Default|GetDP)) (Math|Vector|MakeVector :X 0.0 :Y (* 300.0 (Math|Float|Clamp(Float) :Value (- 1.0 (/ hlen 100.0)) :Min 0.0 :Max 2.0)) :Z 0.0))) :bSweep false :bTeleport true)
          ; probe in basket coordinates: rim message + latch
          (bind loc (Math|Transform|InverseTransformLocation :T (Transformation|GetWorldTransform :self drg) :Location probe))
          (Variables|Default|SetCX (.x loc))
          (Variables|Default|SetCR (Math|Float|Sqrt (+ (* (.y loc) (.y loc)) (* (.z loc) (.z loc)))))
          ; coupling stop: the probe tip can't go deeper than the coupling (45 cm behind the hub) - push the drogue ahead
          ; (sweeps miss a thin probe that is already slightly inside a hull)
          (if (and (and (> (Variables|Default|GetCX) -45.0) (< (Variables|Default|GetCX) 60.0)) (< (Variables|Default|GetCR) 25.0))
            (Variables|Default|SetVN (Math|Float|Min(Float) :A 0.0 :B (Math|Vector|DotProduct :A vrel :B fwd)))
            (Variables|Default|SetDV (- (Variables|Default|GetDV) (* fwd (Variables|Default|GetVN))))
            (Variables|Default|SetP3 (+ (Variables|Default|GetCX) 45.0))
            (Variables|Default|SetDP (+ (Variables|Default|GetDP) (* fwd (Variables|Default|GetP3))))
            (Transformation|SetWorldLocation :self drg :NewLocation (Variables|Default|GetDP) :bSweep false :bTeleport true)
            (Variables|Default|SetCX -45.0))
          (if (and b1 (> (Variables|Default|GetCR) 30.0))
            (Variables|Default|SetMsg "Hit the basket rim - back out and line up again"))
          (if (and (and (== (Variables|Default|GetState) 2) (> t (Variables|Default|GetKO))) (and (and (> (Variables|Default|GetCX) -60.0) (< (Variables|Default|GetCX) 5.0)) (< (Variables|Default|GetCR) 9.0)))
            (bind clos (Variables|Default|GetCL))
            (if (> clos 250.0)
              (Variables|Default|SetDV (+ (Variables|Default|GetDV) (+ (* (Math|Vector|GetRightVector :InRot rot) (Math|Float|SelectFloat :A -200.0 :B 200.0 :bPickA (>= (.y loc) 0.0))) (* (Math|Vector|GetUpVector :InRot rot) 90.0))))
              (Variables|Default|SetWT t)
              (Variables|Default|SetWD (Math|Vector|MakeVector :X (Math|Float|SelectFloat :A 1.0 :B -1.0 :bPickA (> (Math|Trig|Sin(Radians) (* t 7.0)) 0.0)) :Y 0.0 :Z 0.5))
              (Variables|Default|SetMsg "TOO FAST - hose whip, the basket was knocked off (max closure 2.5 m/s)")
              (Variables|Default|SetKO (+ t 1.0))
              (elif (< clos 40.0)
                (Variables|Default|SetMsg "Closure too slow for auto-latch (min 0.5 m/s) - press L to lock")
                (else
                  (Variables|Default|SetState 3)
                  ; locked: the jet stops (speed + keyboard throttle = 0); any stick/key input moves it again
                  (Class|BPMiragePawn|SetVelocity :self mp :Velocity (Math|Vector|MakeVector :X 0.0 :Y 0.0 :Z 0.0))
                  (Class|BPMiragePawn|SetKThr :self mp :KThr 0.0)
                  (Variables|Default|SetMsg "CONTACT! Push in 1.5-9 m for the green light")))))))
      (Variables|Default|SetLP probe)
      ; hose reel: pays out freely, takes up slack at most 2.5 m/s. Closing faster builds slack (hose sags);
      ; > 1.2 m slack while connected -> hose whip + disconnect.
      (bind dd (Math|Vector|Distance(Vector) :V1 pod :V2 (Transformation|GetWorldLocation :self drg)))
      (if (>= dd (Variables|Default|GetReelLen))
        (Variables|Default|SetReelLen dd)
        (else
          (Variables|Default|SetReelLen (Math|Float|Max(Float) :A dd :B (- (Variables|Default|GetReelLen) (* 250.0 DeltaSeconds))))))
      (Variables|Default|SetSL (- (Variables|Default|GetReelLen) dd))
      (if (and (== (Variables|Default|GetState) 3) (> (Variables|Default|GetSL) 120.0))
        (Variables|Default|SetFlowing false)
        (Variables|Default|SetState 2)
        (Variables|Default|SetKO (+ t 1.5))
        (Variables|Default|SetWT t)
        (Variables|Default|SetWD (Math|Vector|MakeVector :X (Math|Float|SelectFloat :A 1.0 :B -1.0 :bPickA (> (Math|Trig|Sin(Radians) (* t 7.0)) 0.0)) :Y 0.0 :Z 0.5))
        (Variables|Default|SetMsg "HOSE WHIP - closure too fast for the reel (max 2.5 m/s), disconnected"))
      ; hose weight bow: trailing/connected the hose gets 1.2% more length than the chord (+12% of the push-in when
      ; connected) so it hangs in a curve; taut while extending/rewinding; + whip slack
      (bind sg (Variables|Default|GetState))
      (Class|CableComponent|SetCableLength :self (Variables|Default|GetHose) :CableLength (Math|Float|Max(Float) :A 20.0 :B (+ (+ (* (Math|Float|SelectFloat :A 1.012 :B 0.99 :bPickA (or (== sg 2) (== sg 3))) (Math|Float|Max(Float) :A dd :B (Variables|Default|GetReelLen))) (* (Math|Float|SelectFloat :A 0.12 :B 0.0 :bPickA (== sg 3)) (Math|Float|Max(Float) :A 0.0 :B (- 2400.0 dd)))) (* 90.0 (Variables|Default|GetWK)))))
      ; pod signal lights: red = hose moving, amber = ready / connected without flow, green = fuel flowing, off = stowed
      (bind sNow (Variables|Default|GetState))
      (Rendering|SetVisibility :self (Variables|Default|GetLightRed) :bNewVisibility (or (== sNow 1) (== sNow 4)) :bPropagateToChildren false)
      (Rendering|SetVisibility :self (Variables|Default|GetLightAmber) :bNewVisibility (or (== sNow 2) (and (== sNow 3) (not (Variables|Default|GetFlowing)))) :bPropagateToChildren false)
      (Rendering|SetVisibility :self (Variables|Default|GetLightGreen) :bNewVisibility (and (== sNow 3) (Variables|Default|GetFlowing)) :bPropagateToChildren false)
      (bind dprobe (Math|Vector|Distance(Vector) :V1 probe :V2 (Transformation|GetWorldLocation :self drg)))
      (bind line (Utilities|String|Append :A (Variables|Default|GetMsg) :B (Utilities|String|Append :A (Utilities|String|Append :A "    |  tip " :B (Utilities|String|Append :A (Utilities|String|ToString(Integer) (Math|Float|Round (Variables|Default|GetCX))) :B (Utilities|String|Append :A " / " :B (Utilities|String|Append :A (Utilities|String|ToString(Integer) (Math|Float|Round (Variables|Default|GetCR))) :B (Utilities|String|Append :A " cm  |  slack " :B (Utilities|String|ToString(Integer) (Math|Float|Round (Variables|Default|GetSL)))))))) :B (Utilities|String|Append :A " cm  |  range " :B (Utilities|String|Append :A (Utilities|String|ToString(Integer) (Math|Float|Round (/ dprobe 100.0))) :B (Utilities|String|Append :A " m  |  closure " :B (Utilities|String|Append :A (Utilities|String|ToString(Integer) (Math|Float|Round (.y vel))) :B (Utilities|String|Append :A " cm/s  |  fuel " :B (Utilities|String|Append :A (Utilities|String|ToString(Integer) (Math|Float|Round (/ (Variables|Default|GetFuel) 31.6))) :B "%")))))))))
      (Development|PrintString :InString "W/S fwd-back   Up/Down throttle (X = 0)   A/D strafe   Space/Ctrl up-down   Shift fast   Mouse look   C recenter   E / btn 2 hose out-in   L lock/unlock   H HUD refuel aid   R restart" :bPrintToScreen true :bPrintToLog false :TextColor "(R=0.7,G=0.7,B=0.7,A=1.0)" :Duration 0.25 :Key "RefuelHelp")
      (if (Variables|Default|GetFlowing)
        (Development|PrintString :InString line :bPrintToScreen true :bPrintToLog false :TextColor "(R=0.1,G=1.0,B=0.2,A=1.0)" :Duration 0.25 :Key "RefuelHUD")
        (else
          (Development|PrintString :InString line :bPrintToScreen true :bPrintToLog false :TextColor "(R=1.0,G=0.65,B=0.0,A=1.0)" :Duration 0.25 :Key "RefuelHUD"))))
    (:CastFailed)))
