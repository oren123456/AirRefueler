(event EventBeginPlay
  ; start with the hose fully trailed (READY); E / joystick button 2 rewinds it
  (bind trail (+ (Transformation|GetActorLocation) (* (Math|Vector|MakeVector :X 0.0 :Y -0.9877 :Z -0.1564) 2400.0)))
  (Physics|SetSimulatePhysics :self (Variables|Default|GetParachute) :bSimulate false)
  (Transformation|SetWorldLocationAndRotation :self (Variables|Default|GetParachute) :NewLocation trail :NewRotation (Math|Rotator|MakeRotfromX :X (- (Transformation|GetActorLocation) trail)) :bSweep false :bTeleport true)
  (Cable|SetAttachEndtoComponent :self (Variables|Default|GetHose) :Component (Variables|Default|GetParachute))
  (Class|CableComponent|SetCableLength :self (Variables|Default|GetHose) :CableLength 2376.0)
  (Variables|Default|SetDP trail)
  (Variables|Default|SetDV (Math|Vector|MakeVector :X 0.0 :Y 0.0 :Z 0.0))
  (Variables|Default|SetFuel 1200.0)
  (Variables|Default|SetHoseLen 2400.0)
  (Variables|Default|SetState 2)
  (Variables|Default|SetMsg "READY (amber) - fly the probe into the basket, closure 0.5-2.5 m/s  (E / button 2 = rewind)"))

(event EventTick (DeltaSeconds)
  (bind t (Utilities|Time|GetGameTimeinSeconds))
  (bind pod (Transformation|GetActorLocation))
  (bind mp (Utilities|Casting|CastToBP_MiragePawn :Object (Game|GetPlayerPawn :PlayerIndex 0))
    (:then
      (bind probe (Transformation|GetWorldLocation :self (Class|BPMiragePawn|GetProbeTip :self mp)))
      (bind vel (Class|BPMiragePawn|GetVelocity :self mp))
      (bind ext (Class|BPMiragePawn|GetExtendCount :self mp))
      (bind st (Variables|Default|GetState))
      ; hose out / in: E or joystick button 2 toggles (no automatic trailing)
      (if (!= ext (Variables|Default|GetLastExtend))
        (Variables|Default|SetLastExtend ext)
        (if (or (== st 0) (== st 4))
          (Variables|Default|SetState 1)
          (Variables|Default|SetMsg "Hose trailing...  (E / button 2 = rewind)")
          (elif (or (== st 1) (== st 2))
            (Variables|Default|SetState 4)
            (Variables|Default|SetMsg "Hose rewinding...  (E / button 2 = trail)"))))
      (if (== st 0)
        (Variables|Default|SetHoseLen (Math|Interpolation|FInterpTo :Current (Variables|Default|GetHoseLen) :Target 30.0 :DeltaTime DeltaSeconds :InterpSpeed 2.0)))
      (if (== st 1)
        (bind hl (+ (Variables|Default|GetHoseLen) (* 200.0 DeltaSeconds)))
        (Variables|Default|SetHoseLen hl)
        (if (>= hl 2400.0)
          (Variables|Default|SetHoseLen 2400.0)
          (Variables|Default|SetState 2)
          (Variables|Default|SetMsg "READY (amber) - fly the probe into the basket, closure 0.5-2.5 m/s  (E / button 2 = rewind)")))
      (if (== st 4)
        (bind hl2 (- (Variables|Default|GetHoseLen) (* 200.0 DeltaSeconds)))
        (Variables|Default|SetHoseLen hl2)
        (if (<= hl2 30.0)
          (Variables|Default|SetState 0)
          (Variables|Default|SetMsg "Hose stowed - E / joystick button 2 to trail again, R = restart")))
      (bind hlen (Variables|Default|GetHoseLen))
      (bind k (/ hlen 2400.0))
      (bind wob (Math|Vector|MakeVector :X (* k (+ (* 12.0 (Math|Trig|Sin(Radians) (* t 0.8))) (* 4.0 (Math|Trig|Sin(Radians) (* t 2.1))))) :Y 0.0 :Z (* k (+ (* 8.0 (Math|Trig|Sin(Radians) (* t 1.1))) (* 3.0 (Math|Trig|Sin(Radians) (* t 2.7)))))))
      (bind free (+ (+ pod (* (Math|Vector|MakeVector :X 0.0 :Y -0.9877 :Z -0.1564) hlen)) wob))
      (bind drg (Variables|Default|GetParachute))
      (if (== (Variables|Default|GetState) 3)
        (bind d (Math|Vector|Distance(Vector) :V1 pod :V2 probe))
        (Variables|Default|SetHoseLen d)
        ; latched: the probe sits in the coupling at the throat (49.5 cm behind the hub); blend there, no snap
        (Variables|Default|SetDP (Math|Interpolation|VInterpTo :Current (Variables|Default|GetDP) :Target (+ probe (* (Math|Vector|GetForwardVector :InRot (Math|Rotator|MakeRotfromX :X (- pod probe))) 49.5)) :DeltaTime DeltaSeconds :InterpSpeed 12.0))
        (Variables|Default|SetDV vel)
        (Transformation|SetWorldLocationAndRotation :self drg :NewLocation (Variables|Default|GetDP) :NewRotation (Math|Rotator|MakeRotfromX :X (- pod (Variables|Default|GetDP))) :bSweep false :bTeleport true)
        (bind push (- 2400.0 d))
        (bind lat (Math|Vector|Distance(Vector) :V1 probe :V2 (+ pod (* (Math|Vector|MakeVector :X 0.0 :Y -0.9877 :Z -0.1564) d))))
        (bind flowing (and (and (> push 150.0) (< push 900.0)) (< (Variables|Default|GetFuel) 3160.0)))
        (Variables|Default|SetFlowing flowing)
        (if flowing
          (Variables|Default|SetFuel (Math|Float|Min(Float) :A 3160.0 :B (+ (Variables|Default|GetFuel) (* 30.0 DeltaSeconds))))
          (Variables|Default|SetMsg "CONNECTED - GREEN: fuel flowing, hold position")
          (else
            (if (>= (Variables|Default|GetFuel) 3160.0)
              (Variables|Default|SetMsg "TANKS FULL - ease back to disconnect")
              (else
                (Variables|Default|SetMsg "CONNECTED - AMBER: push in 1.5-9 m for fuel flow")))))
        (if (< push -150.0)
          (Variables|Default|SetFlowing false)
          (if (>= (Variables|Default|GetFuel) 3160.0)
            (Variables|Default|SetState 4)
            (Variables|Default|SetMsg "Disconnected - refuel complete, hose rewinding")
            (else
              (Variables|Default|SetState 2)
              (Variables|Default|SetMsg "Disconnected (backed out) - try again"))))
        (if (> push 1000.0)
          (Variables|Default|SetFlowing false)
          (Variables|Default|SetState 2)
          (Variables|Default|SetMsg "Too far forward - hose slack, disconnected!"))
        (if (> lat (* 0.2 d))
          (Variables|Default|SetFlowing false)
          (Variables|Default|SetState 2)
          (Variables|Default|SetMsg "Off envelope - probe broke out of the drogue!"))
        (else
          ; ---- free drogue: own integrator; contact = Unreal sweeps of the parachute's 24 convex hulls against the
          ; refuelling probe's per-polygon collision (the only two colliding objects in the scene).
          (bind dt (Math|Float|Min(Float) :A DeltaSeconds :B 0.05))
          (bind kf (Math|Float|Min(Float) :A 1.0 :B (* 4.0 dt)))
          (if (> (Math|Vector|Distance(Vector) :V1 probe :V2 (Variables|Default|GetLP)) 200.0)
            (Variables|Default|SetLP probe))
          ; spring-damper toward the trail point
          (bind V1 (+ (Variables|Default|GetDV) (* (- (* (- free (Variables|Default|GetDP)) 3.0) (* (Variables|Default|GetDV) 2.0)) dt)))
          (Variables|Default|SetDV V1)
          (Variables|Default|SetTG (+ (Variables|Default|GetDP) (* (Variables|Default|GetDV) dt)))
          (bind rot (Math|Rotator|MakeRotfromX :X (- pod (Variables|Default|GetDP))))
          (bind fwd (Math|Vector|GetForwardVector :InRot rot))
          (bind vrel (- (Variables|Default|GetDV) vel))
          ; closure along the basket axis, before any contact changes the drogue velocity
          (Variables|Default|SetCL (Math|Vector|DotProduct :A (- vel (Variables|Default|GetDV)) :B fwd))
          ; 1) carry the drogue by the probe's motion this frame (same relative pose as last frame = no overlap) ...
          (Transformation|SetWorldLocationAndRotation :self drg :NewLocation (+ (Variables|Default|GetDP) (- probe (Variables|Default|GetLP))) :NewRotation rot :bSweep false :bTeleport true)
          ; 2) ... then sweep the hulls to where the drogue wants to be; the probe stops it where they really touch
          (bind hit1 (Transformation|SetWorldLocation :self drg :NewLocation (Variables|Default|GetTG) :bSweep true :bTeleport false))
          (bind (b1 o1 t1 d1 l1 i1 n1 in1) (Collision|BreakHitResult :Hit hit1))
          (if b1
            ; started inside (e.g. right after a disconnect): ease out along the depenetration normal
            (if o1
              (Transformation|SetWorldLocation :self drg :NewLocation (+ (Transformation|GetWorldLocation :self drg) (* n1 2.0)) :bSweep false :bTeleport true))
            ; inelastic contact + friction, relative to the probe; drogue compliance lateral 1 / axial 0.15
            (Variables|Default|SetD1 (- 1.0 (* 0.85 (* (Math|Vector|DotProduct :A n1 :B fwd) (Math|Vector|DotProduct :A n1 :B fwd)))))
            (Variables|Default|SetVN (/ (Math|Float|Min(Float) :A 0.0 :B (Math|Vector|DotProduct :A vrel :B n1)) (Variables|Default|GetD1)))
            (Variables|Default|SetDV (- (- (Variables|Default|GetDV) (* (- n1 (* (* fwd (Math|Vector|DotProduct :A n1 :B fwd)) 0.85)) (Variables|Default|GetVN))) (* (- (- vrel (* n1 (Math|Vector|DotProduct :A vrel :B n1))) (* (* fwd (Math|Vector|DotProduct :A (- vrel (* n1 (Math|Vector|DotProduct :A vrel :B n1))) :B fwd)) 0.85)) kf)))
            ; 3) slide the rest of the move along the contact plane (the canopy funnels the probe)
            (bind rem (- (Variables|Default|GetTG) (Transformation|GetWorldLocation :self drg)))
            (Transformation|SetWorldLocation :self drg :NewLocation (+ (Transformation|GetWorldLocation :self drg) (- rem (* n1 (Math|Vector|DotProduct :A rem :B n1)))) :bSweep true :bTeleport false))
          (Variables|Default|SetDP (Transformation|GetWorldLocation :self drg))
          (Transformation|SetWorldRotation :self drg :NewRotation (Math|Rotator|MakeRotfromX :X (- pod (Variables|Default|GetDP))) :bSweep false :bTeleport true)
          ; probe in basket coordinates: rim message + latch
          (bind loc (Math|Transform|InverseTransformLocation :T (Transformation|GetWorldTransform :self drg) :Location probe))
          (Variables|Default|SetCX (.x loc))
          (Variables|Default|SetCR (Math|Float|Sqrt (+ (* (.y loc) (.y loc)) (* (.z loc) (.z loc)))))
          (if (and b1 (> (Variables|Default|GetCR) 30.0))
            (Variables|Default|SetMsg "Hit the basket rim - back out and line up again"))
          (if (and (and (== (Variables|Default|GetState) 2) (> t (Variables|Default|GetKO))) (and (> (Variables|Default|GetCX) -60.0) (< (Variables|Default|GetCR) 9.0)))
            (bind clos (Variables|Default|GetCL))
            (if (> clos 250.0)
              (Variables|Default|SetDV (+ (Variables|Default|GetDV) (+ (* (Math|Vector|GetRightVector :InRot rot) (Math|Float|SelectFloat :A -200.0 :B 200.0 :bPickA (>= (.y loc) 0.0))) (* (Math|Vector|GetUpVector :InRot rot) 90.0))))
              (Variables|Default|SetMsg "TOO FAST - the basket was knocked off (max closure 2.5 m/s)")
              (Variables|Default|SetKO (+ t 1.0))
              (elif (< clos 40.0)
                (Variables|Default|SetMsg "Closure too slow - the probe did not latch (min 0.5 m/s)")
                (else
                  (Variables|Default|SetState 3)
                  (Variables|Default|SetMsg "CONTACT! Keep pushing in for the green light")))))))
      (Variables|Default|SetLP probe)
      ; hose always taut: cable length = pod-to-drogue distance (slightly shorter -> tension)
      (Class|CableComponent|SetCableLength :self (Variables|Default|GetHose) :CableLength (Math|Float|Max(Float) :A 20.0 :B (* 0.99 (Math|Vector|Distance(Vector) :V1 pod :V2 (Transformation|GetWorldLocation :self drg)))))
      (bind dprobe (Math|Vector|Distance(Vector) :V1 probe :V2 (Transformation|GetWorldLocation :self drg)))
      (bind line (Utilities|String|Append :A (Variables|Default|GetMsg) :B (Utilities|String|Append :A "    |  range " :B (Utilities|String|Append :A (Utilities|String|ToString(Integer) (Math|Float|Round (/ dprobe 100.0))) :B (Utilities|String|Append :A " m  |  closure " :B (Utilities|String|Append :A (Utilities|String|ToString(Integer) (Math|Float|Round (.y vel))) :B (Utilities|String|Append :A " cm/s  |  fuel " :B (Utilities|String|Append :A (Utilities|String|ToString(Integer) (Math|Float|Round (/ (Variables|Default|GetFuel) 31.6))) :B "%"))))))))
      (Development|PrintString :InString "W/S fwd-back   Up/Down throttle (X = 0)   A/D strafe   Space/Ctrl up-down   Shift fast   Mouse look   C recenter   E / btn 2 hose out-in   R restart" :bPrintToScreen true :bPrintToLog false :TextColor "(R=0.7,G=0.7,B=0.7,A=1.0)" :Duration 0.25 :Key "RefuelHelp")
      (if (Variables|Default|GetFlowing)
        (Development|PrintString :InString line :bPrintToScreen true :bPrintToLog false :TextColor "(R=0.1,G=1.0,B=0.2,A=1.0)" :Duration 0.25 :Key "RefuelHUD")
        (else
          (Development|PrintString :InString line :bPrintToScreen true :bPrintToLog false :TextColor "(R=1.0,G=0.65,B=0.0,A=1.0)" :Duration 0.25 :Key "RefuelHUD"))))
    (:CastFailed)))
