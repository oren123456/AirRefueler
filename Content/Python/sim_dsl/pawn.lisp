(event EventTick (DeltaSeconds)
  (bind pc (Game|GetPlayerController :PlayerIndex 0))
  (bind kW (Math|Float|SelectFloat :A 1.0 :B 0.0 :bPickA (Game|Player|IsInputKeyDown :self pc :Key "W")))
  (bind kS (Math|Float|SelectFloat :A 1.0 :B 0.0 :bPickA (Game|Player|IsInputKeyDown :self pc :Key "S")))
  (bind kA (Math|Float|SelectFloat :A 1.0 :B 0.0 :bPickA (Game|Player|IsInputKeyDown :self pc :Key "A")))
  (bind kD (Math|Float|SelectFloat :A 1.0 :B 0.0 :bPickA (Game|Player|IsInputKeyDown :self pc :Key "D")))
  (bind kU (Math|Float|SelectFloat :A 1.0 :B 0.0 :bPickA (Game|Player|IsInputKeyDown :self pc :Key "SpaceBar")))
  (bind kN (Math|Float|SelectFloat :A 1.0 :B 0.0 :bPickA (Game|Player|IsInputKeyDown :self pc :Key "LeftControl")))
  (bind boost (Math|Float|SelectFloat :A 4.0 :B 1.0 :bPickA (Game|Player|IsInputKeyDown :self pc :Key "LeftShift")))
  ; ---- joystick (RawInput generic HID): raw 0..1 -> -1..1, exact 0 = no data yet
  (bind r1 (Game|Player|GetInputAnalogKeyState :self pc :Key "GenericUSBController_Axis1"))
  (bind a1 (Math|Float|SelectFloat :A 0.0 :B (- (* r1 2.0) 1.0) :bPickA (== r1 0.0)))
  (bind r2 (Game|Player|GetInputAnalogKeyState :self pc :Key "GenericUSBController_Axis2"))
  (bind a2 (Math|Float|SelectFloat :A 0.0 :B (- (* r2 2.0) 1.0) :bPickA (== r2 0.0)))
  (bind r3 (Game|Player|GetInputAnalogKeyState :self pc :Key "GenericUSBController_Axis3"))
  (bind a3 (Math|Float|SelectFloat :A 0.0 :B (- (* r3 2.0) 1.0) :bPickA (== r3 0.0)))
  (bind r4 (Game|Player|GetInputAnalogKeyState :self pc :Key "GenericUSBController_Axis4"))
  (bind a4 (Math|Float|SelectFloat :A 0.0 :B (- (* r4 2.0) 1.0) :bPickA (== r4 0.0)))
  (bind r5 (Game|Player|GetInputAnalogKeyState :self pc :Key "GenericUSBController_Axis5"))
  (bind a5 (Math|Float|SelectFloat :A 0.0 :B (- (* r5 2.0) 1.0) :bPickA (== r5 0.0)))
  (bind r6 (Game|Player|GetInputAnalogKeyState :self pc :Key "GenericUSBController_Axis6"))
  (bind a6 (Math|Float|SelectFloat :A 0.0 :B (- (* r6 2.0) 1.0) :bPickA (== r6 0.0)))
  (bind r7 (Game|Player|GetInputAnalogKeyState :self pc :Key "GenericUSBController_Axis7"))
  (bind a7 (Math|Float|SelectFloat :A 0.0 :B (- (* r7 2.0) 1.0) :bPickA (== r7 0.0)))
  (bind r8 (Game|Player|GetInputAnalogKeyState :self pc :Key "GenericUSBController_Axis8"))
  (bind a8 (Math|Float|SelectFloat :A 0.0 :B (- (* r8 2.0) 1.0) :bPickA (== r8 0.0)))
  (bind dz (Variables|Joystick|GetJoyDeadzone))
  (bind jSraw (* (+ (+ (+ (+ (+ (+ (+ (Math|Float|SelectFloat :A a1 :B 0.0 :bPickA (== (Variables|Joystick|GetJoyStrafeAxis) 1)) (Math|Float|SelectFloat :A a2 :B 0.0 :bPickA (== (Variables|Joystick|GetJoyStrafeAxis) 2))) (Math|Float|SelectFloat :A a3 :B 0.0 :bPickA (== (Variables|Joystick|GetJoyStrafeAxis) 3))) (Math|Float|SelectFloat :A a4 :B 0.0 :bPickA (== (Variables|Joystick|GetJoyStrafeAxis) 4))) (Math|Float|SelectFloat :A a5 :B 0.0 :bPickA (== (Variables|Joystick|GetJoyStrafeAxis) 5))) (Math|Float|SelectFloat :A a6 :B 0.0 :bPickA (== (Variables|Joystick|GetJoyStrafeAxis) 6))) (Math|Float|SelectFloat :A a7 :B 0.0 :bPickA (== (Variables|Joystick|GetJoyStrafeAxis) 7))) (Math|Float|SelectFloat :A a8 :B 0.0 :bPickA (== (Variables|Joystick|GetJoyStrafeAxis) 8))) (Math|Float|SelectFloat :A -1.0 :B 1.0 :bPickA (Variables|Joystick|GetJoyInvertStrafe))))
  (bind jS (Math|Float|SelectFloat :A 0.0 :B jSraw :bPickA (< (Math|Float|Absolute(Float) jSraw) dz)))
  (bind jVraw (* (+ (+ (+ (+ (+ (+ (+ (Math|Float|SelectFloat :A a1 :B 0.0 :bPickA (== (Variables|Joystick|GetJoyVertAxis) 1)) (Math|Float|SelectFloat :A a2 :B 0.0 :bPickA (== (Variables|Joystick|GetJoyVertAxis) 2))) (Math|Float|SelectFloat :A a3 :B 0.0 :bPickA (== (Variables|Joystick|GetJoyVertAxis) 3))) (Math|Float|SelectFloat :A a4 :B 0.0 :bPickA (== (Variables|Joystick|GetJoyVertAxis) 4))) (Math|Float|SelectFloat :A a5 :B 0.0 :bPickA (== (Variables|Joystick|GetJoyVertAxis) 5))) (Math|Float|SelectFloat :A a6 :B 0.0 :bPickA (== (Variables|Joystick|GetJoyVertAxis) 6))) (Math|Float|SelectFloat :A a7 :B 0.0 :bPickA (== (Variables|Joystick|GetJoyVertAxis) 7))) (Math|Float|SelectFloat :A a8 :B 0.0 :bPickA (== (Variables|Joystick|GetJoyVertAxis) 8))) (Math|Float|SelectFloat :A -1.0 :B 1.0 :bPickA (Variables|Joystick|GetJoyInvertVert))))
  (bind jV (Math|Float|SelectFloat :A 0.0 :B jVraw :bPickA (< (Math|Float|Absolute(Float) jVraw) dz)))
  (bind jTraw (* (+ (+ (+ (+ (+ (+ (+ (Math|Float|SelectFloat :A a1 :B 0.0 :bPickA (== (Variables|Joystick|GetJoyThrottleAxis) 1)) (Math|Float|SelectFloat :A a2 :B 0.0 :bPickA (== (Variables|Joystick|GetJoyThrottleAxis) 2))) (Math|Float|SelectFloat :A a3 :B 0.0 :bPickA (== (Variables|Joystick|GetJoyThrottleAxis) 3))) (Math|Float|SelectFloat :A a4 :B 0.0 :bPickA (== (Variables|Joystick|GetJoyThrottleAxis) 4))) (Math|Float|SelectFloat :A a5 :B 0.0 :bPickA (== (Variables|Joystick|GetJoyThrottleAxis) 5))) (Math|Float|SelectFloat :A a6 :B 0.0 :bPickA (== (Variables|Joystick|GetJoyThrottleAxis) 6))) (Math|Float|SelectFloat :A a7 :B 0.0 :bPickA (== (Variables|Joystick|GetJoyThrottleAxis) 7))) (Math|Float|SelectFloat :A a8 :B 0.0 :bPickA (== (Variables|Joystick|GetJoyThrottleAxis) 8))) (Math|Float|SelectFloat :A -1.0 :B 1.0 :bPickA (Variables|Joystick|GetJoyInvertThrottle))))
  (bind jT (Math|Float|SelectFloat :A 0.0 :B jTraw :bPickA (< (Math|Float|Absolute(Float) jTraw) dz)))
  (bind jYraw (* (+ (+ (+ (+ (+ (+ (+ (Math|Float|SelectFloat :A a1 :B 0.0 :bPickA (== (Variables|Joystick|GetJoyTwistAxis) 1)) (Math|Float|SelectFloat :A a2 :B 0.0 :bPickA (== (Variables|Joystick|GetJoyTwistAxis) 2))) (Math|Float|SelectFloat :A a3 :B 0.0 :bPickA (== (Variables|Joystick|GetJoyTwistAxis) 3))) (Math|Float|SelectFloat :A a4 :B 0.0 :bPickA (== (Variables|Joystick|GetJoyTwistAxis) 4))) (Math|Float|SelectFloat :A a5 :B 0.0 :bPickA (== (Variables|Joystick|GetJoyTwistAxis) 5))) (Math|Float|SelectFloat :A a6 :B 0.0 :bPickA (== (Variables|Joystick|GetJoyTwistAxis) 6))) (Math|Float|SelectFloat :A a7 :B 0.0 :bPickA (== (Variables|Joystick|GetJoyTwistAxis) 7))) (Math|Float|SelectFloat :A a8 :B 0.0 :bPickA (== (Variables|Joystick|GetJoyTwistAxis) 8))) (Math|Float|SelectFloat :A -1.0 :B 1.0 :bPickA (Variables|Joystick|GetJoyInvertTwist))))
  (bind jY (Math|Float|SelectFloat :A 0.0 :B jYraw :bPickA (< (Math|Float|Absolute(Float) jYraw) dz)))
  (bind sx (Math|Float|Clamp(Float) :Value (- (- kA kD) jS) :Min -1.0 :Max 1.0))
  (bind sy (Math|Float|Clamp(Float) :Value (+ (- kW kS) jT) :Min -1.0 :Max 1.0))
  (bind sz (Math|Float|Clamp(Float) :Value (- (- kU kN) jV) :Min -1.0 :Max 1.0))
  (bind target (Math|Vector|MakeVector :X (* sx 250.0) :Y (* (* sy 300.0) boost) :Z (* sz 200.0)))
  (bind vel (Math|Interpolation|VInterpTo :Current (Variables|Default|GetVelocity) :Target target :DeltaTime DeltaSeconds :InterpSpeed 1.2))
  (Variables|Default|SetVelocity vel)
  (Transformation|AddActorWorldOffset :DeltaLocation (* vel DeltaSeconds) :bSweep false :bTeleport false)
  (Transformation|SetActorRotation :NewRotation (Math|Rotator|MakeRotator :Roll (* (.z vel) -0.012) :Pitch (* (.x vel) -0.012) :Yaw 0.0) :bTeleportPhysics false)
  (bind (dx dy) (Game|Player|GetInputMouseDelta :self pc))
  (bind cy (Math|Float|Clamp(Float) :Value (+ (Variables|Default|GetCamYaw) (* dx 0.2)) :Min -150.0 :Max 150.0))
  (bind cp (Math|Float|Clamp(Float) :Value (+ (Variables|Default|GetCamPitch) (* dy 0.2)) :Min -75.0 :Max 75.0))
  (Variables|Default|SetCamYaw cy)
  (Variables|Default|SetCamPitch cp)
  (Transformation|SetRelativeRotation :self (Variables|Default|GetPilotCam) :NewRotation (Math|Rotator|MakeRotator :Roll 0.0 :Pitch cp :Yaw (+ (+ cy (* jY 90.0)) 90.0)) :bSweep false :bTeleport false)
  (if (or (Game|Player|WasInputKeyJustPressed :self pc :Key "C") (Game|Player|WasInputKeyJustPressed :self pc :Key "GenericUSBController_Button3"))
    (Variables|Default|SetCamYaw 0.0)
    (Variables|Default|SetCamPitch 0.0))
  (if (or (Game|Player|WasInputKeyJustPressed :self pc :Key "E") (Game|Player|WasInputKeyJustPressed :self pc :Key "GenericUSBController_Button2"))
    (Variables|Default|SetExtendCount (+ (Variables|Default|GetExtendCount) 1)))
  (if (Game|Player|WasInputKeyJustPressed :self pc :Key "R")
    (Development|ExecuteConsoleCommand :Command "RestartLevel"))
  (if (Game|Player|WasInputKeyJustPressed :self pc :Key "J")
    (Variables|Joystick|SetJoyDebug (not (Variables|Joystick|GetJoyDebug))))
  (if (Variables|Joystick|GetJoyDebug)
    (Development|PrintString :InString (Utilities|String|Append :A "JOY AXES" :B (Utilities|String|Append :A "  1:" :B (Utilities|String|Append :A (Utilities|String|ToString(Float) r1) :B (Utilities|String|Append :A "  2:" :B (Utilities|String|Append :A (Utilities|String|ToString(Float) r2) :B (Utilities|String|Append :A "  3:" :B (Utilities|String|Append :A (Utilities|String|ToString(Float) r3) :B (Utilities|String|Append :A "  4:" :B (Utilities|String|Append :A (Utilities|String|ToString(Float) r4) :B (Utilities|String|Append :A "  5:" :B (Utilities|String|Append :A (Utilities|String|ToString(Float) r5) :B (Utilities|String|Append :A "  6:" :B (Utilities|String|Append :A (Utilities|String|ToString(Float) r6) :B (Utilities|String|Append :A "  7:" :B (Utilities|String|Append :A (Utilities|String|ToString(Float) r7) :B (Utilities|String|Append :A "  8:" :B (Utilities|String|Append :A (Utilities|String|ToString(Float) r8) :B " | Joystick raw 0..1 -> J to hide"))))))))))))))))) :bPrintToScreen true :bPrintToLog false :TextColor "(R=0.3,G=0.8,B=1.0,A=1.0)" :Duration 0.25 :Key "JoyDebug")))

(event EventBeginPlay
  (bind sub (PlayerController|LocalPlayerSubsystems|GetEnhancedInputLocalPlayerSubsystem :PlayerController (Game|GetPlayerController :PlayerIndex 0)))
  (Input|AddMappingContext :self sub :MappingContext "/Game/AirRefueler/Sim/Input/IMC_Joystick.IMC_Joystick" :Priority 0))
