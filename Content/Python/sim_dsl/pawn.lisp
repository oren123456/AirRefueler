(event EventTick (DeltaSeconds)
  (bind pc (Game|GetPlayerController :PlayerIndex 0))
  (bind kW (Math|Float|SelectFloat :A 1.0 :B 0.0 :bPickA (Game|Player|IsInputKeyDown :self pc :Key "W")))
  (bind kS (Math|Float|SelectFloat :A 1.0 :B 0.0 :bPickA (Game|Player|IsInputKeyDown :self pc :Key "S")))
  (bind kA (Math|Float|SelectFloat :A 1.0 :B 0.0 :bPickA (Game|Player|IsInputKeyDown :self pc :Key "A")))
  (bind kD (Math|Float|SelectFloat :A 1.0 :B 0.0 :bPickA (Game|Player|IsInputKeyDown :self pc :Key "D")))
  (bind kU (Math|Float|SelectFloat :A 1.0 :B 0.0 :bPickA (Game|Player|IsInputKeyDown :self pc :Key "SpaceBar")))
  (bind kN (Math|Float|SelectFloat :A 1.0 :B 0.0 :bPickA (Game|Player|IsInputKeyDown :self pc :Key "LeftControl")))
  (bind boost (Math|Float|SelectFloat :A 4.0 :B 1.0 :bPickA (Game|Player|IsInputKeyDown :self pc :Key "LeftShift")))
  (bind dz (Variables|Joystick|GetJoyDeadzone))
  (bind jSr (Game|Player|GetInputAnalogKeyState :self pc :Key "Gamepad_Special_Left_X"))
  (bind jSraw (* jSr (Math|Float|SelectFloat :A -1.0 :B 1.0 :bPickA (Variables|Joystick|GetJoyInvertStrafe))))
  (bind jS (Math|Float|SelectFloat :A 0.0 :B jSraw :bPickA (< (Math|Float|Absolute(Float) jSraw) dz)))
  (bind jVr (Game|Player|GetInputAnalogKeyState :self pc :Key "Gamepad_Special_Left_Y"))
  (bind jVraw (* jVr (Math|Float|SelectFloat :A -1.0 :B 1.0 :bPickA (Variables|Joystick|GetJoyInvertVert))))
  (bind jV (Math|Float|SelectFloat :A 0.0 :B jVraw :bPickA (< (Math|Float|Absolute(Float) jVraw) dz)))
  (bind jTr (Game|Player|GetInputAnalogKeyState :self pc :Key "Gamepad_RightTriggerAxis"))
  (bind jTraw (* jTr (Math|Float|SelectFloat :A -1.0 :B 1.0 :bPickA (Variables|Joystick|GetJoyInvertThrottle))))
  (bind jT (Math|Float|SelectFloat :A 0.0 :B jTraw :bPickA (< (Math|Float|Absolute(Float) jTraw) dz)))
  (bind sx (Math|Float|Clamp(Float) :Value (- (- kA kD) jS) :Min -1.0 :Max 1.0))
  (bind sy (- kW kS))
  ; throttle: 4 m/s linear + 8 m/s cubic -> fine near centre, 12 m/s at full
  (bind thr (+ (* jT 400.0) (* (* (* jT jT) jT) 800.0)))
  (bind sz (Math|Float|Clamp(Float) :Value (- (- kU kN) jV) :Min -1.0 :Max 1.0))
  ; keyboard throttle (no joystick): Up/Down = +/- 0.25 m/s held forward speed, X = 0
  (if (Game|Player|WasInputKeyJustPressed :self pc :Key "Up")
    (Variables|Default|SetKThr (Math|Float|Min(Float) :A 800.0 :B (+ (Variables|Default|GetKThr) 25.0))))
  (if (Game|Player|WasInputKeyJustPressed :self pc :Key "Down")
    (Variables|Default|SetKThr (Math|Float|Max(Float) :A -300.0 :B (- (Variables|Default|GetKThr) 25.0))))
  (if (Game|Player|WasInputKeyJustPressed :self pc :Key "X")
    (Variables|Default|SetKThr 0.0))
  (bind target (Math|Vector|MakeVector :X (* sx 250.0) :Y (+ (+ (* (* sy 300.0) boost) thr) (Variables|Default|GetKThr)) :Z (* sz 200.0)))
  (bind vel (Math|Interpolation|VInterpTo :Current (Variables|Default|GetVelocity) :Target target :DeltaTime DeltaSeconds :InterpSpeed 1.2))
  (Variables|Default|SetVelocity vel)
  (Transformation|AddActorWorldOffset :DeltaLocation (* vel DeltaSeconds) :bSweep false :bTeleport false)
  (Transformation|SetActorRotation :NewRotation (Math|Rotator|MakeRotator :Roll (* (.z vel) -0.012) :Pitch (* (.x vel) -0.012) :Yaw 0.0) :bTeleportPhysics false)
  (bind (dx dy) (Game|Player|GetInputMouseDelta :self pc))
  (bind cy (Math|Float|Clamp(Float) :Value (+ (Variables|Default|GetCamYaw) (* dx 0.2)) :Min -150.0 :Max 150.0))
  (bind cp (Math|Float|Clamp(Float) :Value (+ (Variables|Default|GetCamPitch) (* dy 0.2)) :Min -75.0 :Max 75.0))
  (Variables|Default|SetCamYaw cy)
  (Variables|Default|SetCamPitch cp)
  (Transformation|SetRelativeRotation :self (Variables|Default|GetPilotCam) :NewRotation (Math|Rotator|MakeRotator :Roll 0.0 :Pitch cp :Yaw (+ cy 90.0)) :bSweep false :bTeleport false)
  (if (or (Game|Player|WasInputKeyJustPressed :self pc :Key "C") (Game|Player|WasInputKeyJustPressed :self pc :Key "GenericUSBController_Button3"))
    (Variables|Default|SetCamYaw 0.0)
    (Variables|Default|SetCamPitch 0.0))
  (if (or (Game|Player|WasInputKeyJustPressed :self pc :Key "E") (Game|Player|WasInputKeyJustPressed :self pc :Key "GenericUSBController_Button2"))
    (Variables|Default|SetExtendCount (+ (Variables|Default|GetExtendCount) 1)))
  (if (Game|Player|WasInputKeyJustPressed :self pc :Key "R")
    (Development|ExecuteConsoleCommand :Command "RestartLevel"))
  (if (Game|Player|WasInputKeyJustPressed :self pc :Key "J")
    (Variables|Joystick|SetJoyDebug (not (Variables|Joystick|GetJoyDebug))))
  (if (Variables|Joystick|GetJoyDebug)
    (Development|PrintString :InString (Utilities|String|Append :A "JOY  strafe X " :B (Utilities|String|Append :A (Utilities|String|ToString(Float) jSr) :B (Utilities|String|Append :A "   vert Y " :B (Utilities|String|Append :A (Utilities|String|ToString(Float) jVr) :B (Utilities|String|Append :A "   throttle " :B (Utilities|String|Append :A (Utilities|String|ToString(Float) jTr) :B "   (J to hide)")))))) :bPrintToScreen true :bPrintToLog true :TextColor "(R=0.3,G=0.8,B=1.0,A=1.0)" :Duration 0.25 :Key "JoyDebug")))

(event EventBeginPlay
  (bind sub (PlayerController|LocalPlayerSubsystems|GetEnhancedInputLocalPlayerSubsystem :PlayerController (Game|GetPlayerController :PlayerIndex 0)))
  (Input|AddMappingContext :self sub :MappingContext "/Game/AirRefueler/Sim/Input/IMC_Joystick.IMC_Joystick" :Priority 0))
