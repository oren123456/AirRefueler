"; BP_MiragePawn \u2014 player Mirage 2000 (whole Mirage_2000N hierarchy is attached to this pawn in the level)\n; Axes: aircraft nose = +Y, right = -X, up = +Z.  W/S fwd/back, A/D strafe, Space/LeftCtrl up/down,\n; LeftShift = x4 speed, mouse = look, C = recenter view, E = trail hose, R = restart.\n(event EventTick (DeltaSeconds)\n  (bind pc (Game|GetPlayerController :PlayerIndex 0))\n  (bind kW (Math|Float|SelectFloat :A 1.0 :B 0.0 :bPickA (Game|Player|IsInputKeyDown :self pc :Key \"W\")))\n  (bind kS (Math|Float|SelectFloat :A 1.0 :B 0.0 :bPickA (Game|Player|IsInputKeyDown :self pc :Key \"S\")))\n  (bind kA (Math|Float|SelectFloat :A 1.0 :B 0.0 :bPickA (Game|Player|IsInputKeyDown :self pc :Key \"A\")))\n  (bind kD (Math|Float|SelectFloat :A 1.0 :B 0.0 :bPickA (Game|Player|IsInputKeyDown :self pc :Key \"D\")))\n  (bind kU (Math|Float|SelectFloat :A 1.0 :B 0.0 :bPickA (Game|Player|IsInputKeyDown :self pc :Key \"SpaceBar\")))\n  (bind kN (Math|Float|SelectFloat :A 1.0 :B 0.0 :bPickA (Game|Player|IsInputKeyDown :self pc :Key \"LeftControl\")))\n  (bind boost (Math|Float|SelectFloat :A 4.0 :B 1.0 :bPickA (Game|Player|IsInputKeyDown :self pc :Key \"LeftShift\")))\n  (bind target (Math|Vector|MakeVector :X (* (- kA kD) 250.0) :Y (* (* (- kW kS) 300.0) boost) :Z (* (- kU kN) 200.0)))\n  (bind vel (Math|Interpolation|VInterpTo :Current (Variables|Default|GetVelocity) :Target target :DeltaTime DeltaSeconds :InterpSpeed 1.2))\n  (Variables|Default|SetVelocity vel)\n  (Transformation|AddActorWorldOffset :DeltaLocation (* vel DeltaSeconds) :bSweep false :bTeleport false)\n  (Transformation|SetActorRotation :NewRotation (Math|Rotator|MakeRotator :Roll (* (.z vel) -0.012) :Pitch (* (.x vel) -0.012) :Yaw 0.0) :bTeleportPhysics false)\n  (bind (dx dy) (Game|Player|GetInputMouseDelta :self pc))\n  (bind cy (Math|Float|Clamp(Float) :Value (+ (Variables|Default|GetCamYaw) (* dx 0.2)) :Min -150.0 :Max 150.0))\n  (bind cp (Math|Float|Clamp(Float) :Value (+ (Variables|Default|GetCamPitch) (* dy 0.2)) :Min -75.0 :Max 75.0))\n  (Variables|Default|SetCamYaw cy)\n  (Variables|Default|SetCamPitch cp)\n  (Transformation|SetRelativeRotation :self (Variables|Default|GetPilotCam) :NewRotation (Math|Rotator|MakeRotator :Roll 0.0 :Pitch cp :Yaw (+ cy 90.0)) :bSweep false :bTeleport false)\n  (if (Game|Player|WasInputKeyJustPressed :self pc :Key \"C\")\n    (Variables|Default|SetCamYaw 0.0)\n    (Variables|Default|SetCamPitch 0.0))\n  (if (Game|Player|WasInputKeyJustPressed :self pc :Key \"E\")\n    (Variables|Default|SetExtendCount (+ (Variables|Default|GetExtendCount) 1)))\n  (if (Game|Player|WasInputKeyJustPressed :self pc :Key \"R\")\n    (Development|ExecuteConsoleCommand :Command \"RestartLevel\")))\n"
